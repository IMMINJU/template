{
  "components": {
    "schemas": {
      "ApiError": {
        "description": "오류 형식 (모든 서버 공통): { \"error\": \"...\" }. 잘못된 입력 400, 그 외 502",
        "properties": {
          "error": {
            "title": "Error",
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "title": "ApiError",
        "type": "object"
      },
      "Rule": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "keyword": {
            "title": "Keyword",
            "type": "string"
          },
          "tag": {
            "title": "Tag",
            "type": "string"
          }
        },
        "required": [
          "id",
          "keyword",
          "tag"
        ],
        "title": "Rule",
        "type": "object"
      },
      "RuleInput": {
        "description": "검증 · 문서가 이 모델 하나에서 나온다. 클래스 이름이 openapi 스키마 이름이라 이 서버 안에서 유일하게.\n모르는 필드는 버린다 (pydantic 기본). 문자열 자리에 숫자가 오면 400",
        "properties": {
          "keyword": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Keyword",
            "type": "string"
          },
          "tag": {
            "maxLength": 30,
            "minLength": 1,
            "title": "Tag",
            "type": "string"
          }
        },
        "required": [
          "keyword",
          "tag"
        ],
        "title": "RuleInput",
        "type": "object"
      },
      "RuleList": {
        "properties": {
          "rules": {
            "items": {
              "$ref": "#/components/schemas/Rule"
            },
            "title": "Rules",
            "type": "array"
          }
        },
        "required": [
          "rules"
        ],
        "title": "RuleList",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "tags",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/tags/rules": {
      "get": {
        "operationId": "listRules",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuleList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Rules"
      },
      "post": {
        "operationId": "createRule",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RuleInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Rule"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "잘못된 요청"
          }
        },
        "summary": "Create Rule"
      }
    },
    "/api/tags/rules/{id}": {
      "delete": {
        "operationId": "deleteRule",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "exclusiveMinimum": 0,
              "maximum": 9223372036854775807,
              "title": "Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "잘못된 요청"
          }
        },
        "summary": "Delete Rule"
      }
    }
  }
}
