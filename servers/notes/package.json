{
  "name": "@app/notes",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "test": "node --test --test-concurrency=1 'tests/**/*_specs.ts' 'tests/**/*.test.ts'",
    "gen": "node src/openapi.ts",
    "migrate": "node-pg-migrate -j sql --migration-filename-format index",
    "typecheck": "tsc -p .",
    "lint": "oxlint && oxfmt --check",
    "format": "oxfmt"
  },
  "dependencies": {
    "@app/contract": "workspace:*",
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2"
  }
}
