# API 서버 포트. 바꾸면 이 서버를 부르는 앱의 NOTES_URL 도 같이 (web · lite 는 dev 때, site 는 빌드 때)
# PORT=8000
# 개발은 이 맥에서만. 컨테이너 등 밖에 열 때 0.0.0.0 (인증 · TLS 먼저)
# HOST=127.0.0.1
# 부르는 다른 서버 (gRPC). 저장 전에 tags, 저장 뒤에 activity
# TAGS_GRPC=http://127.0.0.1:9002
# ACTIVITY_GRPC=http://127.0.0.1:9001
# DB (docker/docker-compose.middleware.yaml 의 Postgres). 테스트는 tests/support/api.ts 가 notes_test 로 바꾼다
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=notes
# PGUSER=app
# PGPASSWORD=app
