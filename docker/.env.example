# docker/.env 로 복사해서 쓴다 (gitignore). 비우면 기본값
# Postgres 를 여는 포트 (이 맥에서만). 바꾸면 서버 · 테스트에도 PGPORT
# POSTGRES_PORT=5432
# 전체 스택(pnpm stack)이 여는 포트. 개발 서버와 같이 띄우려면 다르게
# NOTES_PORT=8000
# ACTIVITY_PORT=8001
# TAGS_PORT=8002
# TEMPLATES_PORT=8003
# WEB_PORT=5280
# ADMIN_PORT=5281
# SITE_PORT=5282
# LITE_PORT=5283
