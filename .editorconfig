root = true

[*]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true
charset = utf-8
end_of_line = lf

# 각 언어 포매터와 맞춘다: spring-javaformat · gofmt = 탭, ruff · rustfmt = 4칸
[*.{java,kts,go}]
indent_style = tab
indent_size = 4

[*.{py,pyi,rs}]
indent_size = 4
